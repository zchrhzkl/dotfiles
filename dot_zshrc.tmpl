{{ if eq .chezmoi.os "darwin" -}}
# ── macOS ────────────────────────────────────────────────────────────────────
#zmodload zsh/zprof

# Homebrew prefix — resolved without forking `brew --prefix` on every startup
if [[ -x /opt/homebrew/bin/brew ]]; then
  export HOMEBREW_PREFIX=/opt/homebrew
elif [[ -x /usr/local/bin/brew ]]; then
  export HOMEBREW_PREFIX=/usr/local
fi

# zsh plugins come from Homebrew formulae
ZSH_PLUGIN_DIR="$HOMEBREW_PREFIX/share"

# Platform PATH
export PATH="$HOMEBREW_PREFIX/opt/mysql-client/bin:$PATH"
export PATH="$HOMEBREW_PREFIX/opt/helm@3/bin:$PATH"
export PATH="$HOME/.venv-vllm-metal/bin:$PATH"
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
export PATH="$HOME/.antigravity-ide/antigravity-ide/bin:$PATH"
export PATH="$PATH:$HOME/.lmstudio/bin"

# Homebrew's own completions (kubectl, helm, gh, ...). The old .zshrc had this
# line but referenced $HOMEBREW_PREFIX before setting it, so it silently added
# an empty path and these 25 completions never loaded.
[[ -d "$HOMEBREW_PREFIX/share/zsh/site-functions" ]] &&
  fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)

# nvm — lazy-loaded: sourcing nvm.sh eagerly costs ~500ms of startup, so the
# real thing is only loaded on first use of node/npm/npx.
export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  nvm()  { unset -f nvm node npm npx; . "$NVM_DIR/nvm.sh"; nvm "$@" }
  node() { nvm >/dev/null && node "$@" }
  npm()  { nvm >/dev/null && npm "$@" }
  npx()  { nvm >/dev/null && npx "$@" }
fi

{{ else -}}
# ── Linux ─────────────────────────────────────────────────────────────────────
# zsh plugins are git-cloned here by run_once_02 (same layout as Homebrew's
# share dir, so the shared sourcing logic below is identical on both platforms)
ZSH_PLUGIN_DIR="$HOME/.local/share/zsh/plugins"

{{ end -}}
# ── Shared ────────────────────────────────────────────────────────────────────

# PATH
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"

# History — zsh's own defaults are HISTFILE=unset / SAVEHIST=0, i.e. nothing is
# persisted. These were previously supplied by oh-my-zsh's lib/history.zsh.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt extended_history       # record timestamps
setopt hist_expire_dups_first # trim duplicates before unique entries
setopt hist_ignore_dups       # skip a command identical to the previous one
setopt hist_ignore_space      # skip commands prefixed with a space
setopt hist_reduce_blanks     # normalise whitespace before storing
setopt hist_verify            # expand !! for review instead of running it blind
setopt share_history          # live history sharing across open shells

# Completions — the completion dir must join fpath before compinit runs.
# Guard on existence: a missing fpath entry makes compinit abort outright,
# which would leave a first-run shell (pre-bootstrap) with no completions.
# Homebrew ships the _* files at zsh-completions/, a git clone at src/.
for _zsh_comp in "$ZSH_PLUGIN_DIR/zsh-completions/src" "$ZSH_PLUGIN_DIR/zsh-completions"; do
  [[ -d "$_zsh_comp" ]] && { fpath=("$_zsh_comp" $fpath); break }
done
unset _zsh_comp

_zcompdump="${XDG_CACHE_HOME:-$HOME/.cache}/zcompdump"
[[ -d "${_zcompdump:h}" ]] || mkdir -p "${_zcompdump:h}"
autoload -Uz compinit
compinit -d "$_zcompdump"
unset _zcompdump

# Plugins. Order matters: syntax-highlighting wraps the widgets the earlier
# plugins define, and history-substring-search must come after it so its own
# widgets get highlighted correctly.
for _zsh_plugin in \
  zsh-autosuggestions/zsh-autosuggestions.zsh \
  zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  zsh-history-substring-search/zsh-history-substring-search.zsh
do
  [[ -r "$ZSH_PLUGIN_DIR/$_zsh_plugin" ]] && source "$ZSH_PLUGIN_DIR/$_zsh_plugin"
done
unset _zsh_plugin

# history-substring-search bindings (arrow keys)
if (( $+widgets[history-substring-search-up] )); then
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
fi

# Prompt
command -v starship >/dev/null && eval "$(starship init zsh)"

# Tool shims
command -v mise     >/dev/null && eval "$(mise activate zsh)"
command -v switcher >/dev/null && source <(switcher init zsh)
command -v switch   >/dev/null && source <(switch completion zsh)

# Kubernetes
alias k="kubectl"
alias kx="switch"
alias kns="switch ns"
alias kg="kubectl get"
alias kd="kubectl describe"
alias kl="kubectl logs"
alias kgp="kubectl get pod"
alias klf="kubectl logs -f"

# Tools
alias vim="nvim"
alias cat="bat --paging=never"
alias awp='export AWS_PROFILE=$(aws configure list-profiles | fzf --prompt "Select AWS profile: ")'

#zprof
