#!/bin/bash
# Install oh-my-zsh + plugins — Linux only, runs once
{{ if eq .chezmoi.os "linux" -}}
set -e

# oh-my-zsh
if [ ! -d "$HOME/.oh-my-zsh" ]; then
  echo "==> Installing oh-my-zsh..."
  RUNZSH=no CHSH=no sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
fi

ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

# zsh plugins
for plugin_repo in \
  "zsh-users/zsh-autosuggestions" \
  "zsh-users/zsh-completions" \
  "zsh-users/zsh-syntax-highlighting"; do
  plugin_name="${plugin_repo##*/}"
  target="$ZSH_CUSTOM/plugins/$plugin_name"
  if [ ! -d "$target" ]; then
    echo "==> Cloning $plugin_name..."
    git clone --depth=1 "https://github.com/$plugin_repo" "$target"
  fi
done

# Set zsh as default shell
if [ "$SHELL" != "$(which zsh)" ]; then
  echo "==> Setting zsh as default shell..."
  chsh -s "$(which zsh)"
fi

echo "==> zsh setup complete."
{{ else -}}
echo "==> Skipping zsh setup (macOS uses antidote via Brewfile)."
{{ end -}}
