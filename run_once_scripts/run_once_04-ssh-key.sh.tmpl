#!/bin/bash
# Fetch age-encrypted SSH key from OneDrive and install it — runs once
set -e

KEY_FILE="$HOME/.ssh/{{ .sshKey }}"
ENCRYPTED="/tmp/{{ .sshKey }}.age"
ONEDRIVE_SECRETS="dotfiles-secrets"

# Skip if key already exists
if [ -f "$KEY_FILE" ]; then
  echo "==> SSH key already exists at $KEY_FILE, skipping."
  exit 0
fi

# Ask user whether to set up SSH key
echo ""
read -r -p "==> Set up SSH key from OneDrive? [y/N] " answer
case "$answer" in
  [yY][eE][sS]|[yY]) ;;
  *)
    echo "==> Skipping SSH key setup. Run chezmoi apply again when ready."
    exit 0
    ;;
esac

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

{{ if eq .chezmoi.os "darwin" -}}
# macOS: OneDrive for Mac mounts at ~/OneDrive
ONEDRIVE="$HOME/OneDrive"
if [ ! -d "$ONEDRIVE" ]; then
  echo "ERROR: ~/OneDrive not found. Install OneDrive for Mac and sign in first."
  exit 1
fi
echo "==> Fetching encrypted key from OneDrive..."
cp "$ONEDRIVE/$ONEDRIVE_SECRETS/{{ .sshKey }}.age" "$ENCRYPTED"

{{ else -}}
# Linux: use rclone with OneDrive backend
if ! command -v rclone &>/dev/null; then
  echo "ERROR: rclone not found. Run run_once_01-packages first."
  exit 1
fi
if ! rclone listremotes | grep -q "^onedrive:"; then
  echo "ERROR: rclone OneDrive remote not configured."
  echo "Run: rclone config  (create a remote named 'onedrive' using Microsoft OneDrive)"
  exit 1
fi
echo "==> Fetching encrypted key from OneDrive via rclone..."
rclone copy "onedrive:$ONEDRIVE_SECRETS/{{ .sshKey }}.age" /tmp/

{{ end -}}

# Decrypt with age (prompts for passphrase)
if ! command -v age &>/dev/null; then
  echo "ERROR: age not found. Install it first (brew install age / apt install age)."
  exit 1
fi

echo "==> Decrypting SSH key (enter your age passphrase when prompted)..."
age -d "$ENCRYPTED" > "$KEY_FILE"
rm -f "$ENCRYPTED"
chmod 600 "$KEY_FILE"

# Generate public key if missing
if [ ! -f "${KEY_FILE}.pub" ]; then
  ssh-keygen -y -f "$KEY_FILE" > "${KEY_FILE}.pub"
fi

# Load into SSH agent
{{ if eq .chezmoi.os "darwin" -}}
ssh-add --apple-use-keychain "$KEY_FILE"
{{ else -}}
ssh-add "$KEY_FILE" 2>/dev/null || true
{{ end -}}

echo "==> SSH key installed at $KEY_FILE"
echo ""
echo "Public key (add to GitHub/GitLab if this is a new machine):"
cat "${KEY_FILE}.pub"
